// Central no Cloudflare Workers (só arquivos estáticos; o servidor é o Supabase).
{
  "name": "manual-zomboid-central",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "central.manualzomboid.site", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
